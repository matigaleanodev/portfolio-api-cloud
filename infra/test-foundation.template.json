              "Action": [
                "iam:GetRole",
                "iam:DeleteRole",
                "iam:PutRolePolicy",
                "iam:GetRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListRolePolicies",
                "iam:TagRole",
                "iam:UntagRole"
              ],
              "Resource": ["arn:aws:iam::650387442642:role/PortfolioApiCloudTestRuntimeRole"]
            },
            {
              "Sid": "PassExactRuntime",
              "Effect": "Allow",
              "Action": ["iam:PassRole"],
              "Resource": ["arn:aws:iam::650387442642:role/PortfolioApiCloudTestRuntimeRole"],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "lambda.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadBootstrapVersion",
              "Effect": "Allow",
              "Action": ["ssm:GetParameters"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/cdk-bootstrap/papiatest/version"
              ]
            },
            {
              "Sid": "ReadAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            },
            {
              "Fn::If": [
                "RegionalApiBootstrap",
                {
                  "Sid": "CreateNamedApi",
                  "Effect": "Allow",
                  "Action": ["apigateway:POST"],
                  "Resource": ["arn:aws:apigateway:us-east-1::/apis"],
                  "Condition": {
                    "StringEquals": {
                      "apigateway:Request/ApiName": "portfolio-api-cloud-test"
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Fn::If": [
                "ApiManagementEnabled",
                {
                  "Sid": "ManageApiResources",
                  "Effect": "Allow",
                  "Action": [
                    "apigateway:GET",
                    "apigateway:POST",
                    "apigateway:PATCH",
                    "apigateway:PUT",
                    "apigateway:DELETE"
                  ],
                  "Resource": {
                    "Fn::If": [
                      "HasApiId",
                      [
                        {
                          "Fn::Sub": "arn:aws:apigateway:us-east-1::/apis/${TestApiId}"
                        },
                        {
                          "Fn::Sub": "arn:aws:apigateway:us-east-1::/apis/${TestApiId}/*"
                        }
                      ],
                      ["arn:aws:apigateway:us-east-1::/apis/*"]
                    ]
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestRuntimeBoundary",
        "PolicyDocument": {

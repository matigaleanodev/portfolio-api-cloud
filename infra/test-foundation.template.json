              ],
              "Resource": [
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test:*"

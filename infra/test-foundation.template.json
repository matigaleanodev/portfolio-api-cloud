{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Review-only personal test foundation. API administration is disabled by default.",
  "Parameters": {
    "RuntimeSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:us-east-1:650387442642:secret:portfolio-api-cloud/test/[A-Za-z0-9/_+=.@-]+"
    },
    "AllowRegionalApiBootstrap": {
      "Type": "String",
      "AllowedValues": ["false", "true"],
      "Default": "false",
      "Description": "Temporary regional HTTP API administration; explicit scope exception required."
    },
    "TestApiId": {
      "Type": "String",
      "AllowedPattern": "unassigned|[a-z0-9]{1,20}",
      "Default": "unassigned"
    }
  },
  "Rules": {
    "PersonalTestOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              "650387442642"
            ]
          },
          "AssertDescription": "Personal account only"
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "us-east-1 only"
        }
      ]
    }
  },
  "Conditions": {
    "HasApiId": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "TestApiId"
            },
            "unassigned"
          ]
        }
      ]
    },
    "RegionalApiBootstrap": {
      "Fn::Equals": [
        {
          "Ref": "AllowRegionalApiBootstrap"
        },
        "true"
      ]
    },
    "ApiManagementEnabled": {
      "Fn::Or": [
        {
          "Condition": "HasApiId"
        },
        {
          "Condition": "RegionalApiBootstrap"
        }
      ]
    }
  },
  "Resources": {
    "AssetBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "cdk-papiatest-assets-650387442642-us-east-1",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "AssetBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AssetBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                "arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1",
                "arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "BootstrapVersionParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": "/cdk-bootstrap/papiatest/version",
        "Type": "String",
        "Value": "6"
      }
    },
    "GitHubBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestGitHubBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AssumeDeliveryRoles",
              "Effect": "Allow",
              "Action": ["sts:AssumeRole"],
              "Resource": [
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCdkDeployRole",
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestFilePublishingRole"
              ]
            }
          ]
        }
      }
    },
    "DeployBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestDeployBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PrepareOnly",
              "Effect": "Allow",
              "Action": ["cloudformation:CreateChangeSet"],
              "Resource": [
                "arn:aws:cloudformation:us-east-1:650387442642:stack/portfolio-api-cloud-test/*"
              ],
              "Condition": {
                "StringEquals": {
                  "cloudformation:RoleArn": "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCloudFormationExecutionRole"
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "portfolio-api-cloud-test-*"
                }
              }
            },
            {
              "Sid": "InspectTestStack",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeChangeSet",
                "cloudformation:DeleteChangeSet",
                "cloudformation:DescribeStacks",
                "cloudformation:DescribeStackEvents",
                "cloudformation:GetTemplate",
                "cloudformation:GetTemplateSummary"
              ],
              "Resource": [
                "arn:aws:cloudformation:us-east-1:650387442642:stack/portfolio-api-cloud-test/*"
              ]
            },
            {
              "Sid": "ReadBootstrapVersion",
              "Effect": "Allow",
              "Action": ["ssm:GetParameter", "ssm:GetParameters"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/cdk-bootstrap/papiatest/version"
              ]
            },
            {
              "Sid": "PassExactExecutor",
              "Effect": "Allow",
              "Action": ["iam:PassRole"],
              "Resource": [
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCloudFormationExecutionRole"
              ],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadAssetBucket",
              "Effect": "Allow",
              "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:GetEncryptionConfiguration"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1"]
            },
            {
              "Sid": "ReadAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            }
          ]
        }
      }
    },
    "PublisherBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestPublisherBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "InspectAssetBucket",
              "Effect": "Allow",
              "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:GetEncryptionConfiguration"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1"]
            },
            {
              "Sid": "PublishAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject", "s3:PutObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            }
          ]
        }
      }
    },
    "ExecutionBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",

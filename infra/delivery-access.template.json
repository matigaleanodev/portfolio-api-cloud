          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Principal": {
                "Federated": "arn:aws:iam::650387442642:oidc-provider/token.actions.githubusercontent.com"
              },
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:matigaleanodev@99203645/portfolio-api-cloud@1432631186:environment:production-foundation-plan"
                }
              }
            }
          ]
        },
        "MaxSessionDuration": 3600,
        "PermissionsBoundary": {
          "Ref": "FoundationPlanBoundary"
        },
        "Policies": [
          {
            "PolicyName": "ScopedDelivery",

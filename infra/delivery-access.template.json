{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "External trust seed for portfolio-api-cloud; requires an existing authorized workflow identity. No self-bootstrap.",
  "Rules": {
    "PersonalTestOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              "650387442642"
            ]
          },
          "AssertDescription": "Personal account only"
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "us-east-1 only"
        }
      ]
    }
  },
  "Resources": {
    "FoundationPlanBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestFoundationPlanBoundary",

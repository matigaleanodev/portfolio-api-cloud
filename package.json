{
  "name": "portfolio-api-cloud",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^24.22.1"
  },
  "workspaces": [
    "packages/contracts",
    "packages/runtime",
    "packages/infrastructure"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.infra.json",
    "build": "npm run build --workspace=@portfolio-api-cloud/runtime",
    "test": "node scripts/prepare-infra.mjs validationScenario=success && node scripts/test.mjs",
    "test:app": "node scripts/test.mjs --project application",
    "test:editorial": "node scripts/test.mjs --project editorial --passWithNoTests",
    "test:tooling": "node scripts/test.mjs --project tooling",
    "test:infra": "node scripts/prepare-infra.mjs validationScenario=success && node scripts/test.mjs --project infrastructure",
    "test:package": "node scripts/test-package.mjs",
    "synth": "npm run synth --workspace=@portfolio-api-cloud/infrastructure",
    "synth:local": "node scripts/synth-local.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run boundaries && npm run format:check && npm run typecheck && npm test && npm run test:package && npm run synth:local && npm run check:docs",
    "check:docs": "python3 scripts/check_docs.py",
    "cdk": "cdk",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

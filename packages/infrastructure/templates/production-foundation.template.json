{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Review-only personal test foundation. API administration is disabled by default.",
  "Parameters": {
    "PreviousRuntimeSecretArn": {
      "Type": "String",
      "AllowedPattern": "none|arn:aws:secretsmanager:us-east-1:650387442642:secret:portfolio-api-cloud/test/[A-Za-z0-9/_+=.@-]+",
      "Description": "Secret still read by the deployed 1.0 runtime until the SSM-based application change set runs; \"none\" explicitly grants nothing."
    },
    "AllowRegionalApiBootstrap": {
      "Type": "String",
      "AllowedValues": ["false", "true"],
      "Default": "false",
      "Description": "Temporary regional HTTP API administration; explicit scope exception required."
    },
    "TestApiId": {
      "Type": "String",
      "AllowedPattern": "unassigned|[a-z0-9]{1,20}",
      "Default": "unassigned"
    }
  },
  "Rules": {
    "PersonalTestOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              "650387442642"
            ]
          },
          "AssertDescription": "Personal account only"
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "us-east-1 only"
        }
      ]
    }
  },
  "Conditions": {
    "HasApiId": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "TestApiId"
            },
            "unassigned"
          ]
        }
      ]
    },
    "RegionalApiBootstrap": {
      "Fn::Equals": [
        {
          "Ref": "AllowRegionalApiBootstrap"
        },
        "true"
      ]
    },
    "ApiManagementEnabled": {
      "Fn::Or": [
        {
          "Condition": "HasApiId"
        },
        {
          "Condition": "RegionalApiBootstrap"
        }
      ]
    },
    "HasPreviousRuntimeSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PreviousRuntimeSecretArn"
            },
            "none"
          ]
        }
      ]
    }
  },
  "Resources": {
    "AssetBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": "cdk-papiatest-assets-650387442642-us-east-1",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "AssetBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AssetBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                "arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1",
                "arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "BootstrapVersionParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": "/cdk-bootstrap/papiatest/version",
        "Type": "String",
        "Value": "6"
      }
    },
    "GitHubBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestGitHubBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AssumeDeliveryRoles",
              "Effect": "Allow",
              "Action": ["sts:AssumeRole"],
              "Resource": [
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCdkDeployRole",
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestFilePublishingRole"
              ]
            },
            {
              "Sid": "VerifyRuntimeParameters",
              "Effect": "Allow",
              "Action": ["ssm:GetParameters"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/api",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/chat",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/editorial",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/notifications"
              ]
            }
          ]
        }
      }
    },
    "DeployBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestDeployBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PrepareOnly",
              "Effect": "Allow",
              "Action": ["cloudformation:CreateChangeSet"],
              "Resource": [
                "arn:aws:cloudformation:us-east-1:650387442642:stack/portfolio-api-cloud-test/*"
              ],
              "Condition": {
                "StringEquals": {
                  "cloudformation:RoleArn": "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCloudFormationExecutionRole"
                },
                "StringLike": {
                  "cloudformation:ChangeSetName": "portfolio-api-cloud-test-*"
                }
              }
            },
            {
              "Sid": "InspectTestStack",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeChangeSet",
                "cloudformation:DeleteChangeSet",
                "cloudformation:DescribeStacks",
                "cloudformation:DescribeStackEvents",
                "cloudformation:GetTemplate",
                "cloudformation:GetTemplateSummary"
              ],
              "Resource": [
                "arn:aws:cloudformation:us-east-1:650387442642:stack/portfolio-api-cloud-test/*"
              ]
            },
            {
              "Sid": "ReadBootstrapVersion",
              "Effect": "Allow",
              "Action": ["ssm:GetParameter", "ssm:GetParameters"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/cdk-bootstrap/papiatest/version"
              ]
            },
            {
              "Sid": "PassExactExecutor",
              "Effect": "Allow",
              "Action": ["iam:PassRole"],
              "Resource": [
                "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCloudFormationExecutionRole"
              ],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadAssetBucket",
              "Effect": "Allow",
              "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:GetEncryptionConfiguration"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1"]
            },
            {
              "Sid": "ReadAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            }
          ]
        }
      }
    },
    "PublisherBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestPublisherBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "InspectAssetBucket",
              "Effect": "Allow",
              "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:GetEncryptionConfiguration"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1"]
            },
            {
              "Sid": "PublishAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject", "s3:PutObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            }
          ]
        }
      }
    },
    "ExecutionBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestExecutionBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ManageFunction",
              "Effect": "Allow",
              "Action": [
                "lambda:CreateFunction",
                "lambda:GetFunction",
                "lambda:GetFunctionConfiguration",
                "lambda:GetFunctionCodeSigningConfig",
                "lambda:GetFunctionRecursionConfig",
                "lambda:GetRuntimeManagementConfig",
                "lambda:GetFunctionScalingConfig",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:DeleteFunction",
                "lambda:GetPolicy",
                "lambda:PutFunctionConcurrency",
                "lambda:DeleteFunctionConcurrency",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:ListTags"
              ],
              "Resource": [
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test",
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-*"
              ]
            },
            {
              "Sid": "PermitApiGatewayInvoke",
              "Effect": "Allow",
              "Action": ["lambda:AddPermission", "lambda:RemovePermission"],
              "Resource": [
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test",
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-chat"
              ],
              "Condition": {
                "StringEquals": {
                  "lambda:Principal": "apigateway.amazonaws.com"
                }
              }
            },
            {
              "Sid": "PermitReleaseInvoke",
              "Effect": "Allow",
              "Action": ["lambda:AddPermission", "lambda:RemovePermission"],
              "Resource": [
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-process-release",
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-publish-chat-knowledge"
              ],
              "Condition": {
                "StringEquals": {
                  "lambda:Principal": "arn:aws:iam::650387442642:role/PortfolioGitHubReleaseRole"
                }
              }
            },
            {
              "Sid": "ManageControlTable",
              "Effect": "Allow",
              "Action": [
                "dynamodb:CreateTable",
                "dynamodb:DescribeTable",
                "dynamodb:UpdateTable",
                "dynamodb:DeleteTable",
                "dynamodb:DescribeTimeToLive",
                "dynamodb:UpdateTimeToLive",
                "dynamodb:TagResource",
                "dynamodb:UntagResource",
                "dynamodb:ListTagsOfResource",
                "dynamodb:DescribeContinuousBackups",
                "dynamodb:DescribeContributorInsights",
                "dynamodb:DescribeKinesisStreamingDestination",
                "dynamodb:GetResourcePolicy"
              ],
              "Resource": [
                "arn:aws:dynamodb:us-east-1:650387442642:table/portfolio-api-cloud-test-control"
              ]
            },
            {
              "Sid": "ManageLogGroup",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogGroup",
                "logs:PutRetentionPolicy",
                "logs:DeleteRetentionPolicy",
                "logs:TagResource",
                "logs:UntagResource",
                "logs:ListTagsForResource",
                "logs:GetDataProtectionPolicy",
                "logs:PutMetricFilter",
                "logs:DeleteMetricFilter",
                "logs:DescribeMetricFilters"
              ],
              "Resource": [
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test*"
              ]
            },
            {
              "Sid": "DiscoverLogGroups",
              "Effect": "Allow",
              "Action": [
                "logs:DescribeLogGroups",
                "logs:DescribeResourcePolicies",
                "logs:DescribeIndexPolicies"
              ],
              "Resource": ["*"],
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "us-east-1"
                }
              }
            },
            {
              "Sid": "ManageAlarms",
              "Effect": "Allow",
              "Action": [
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:DeleteAlarms",
                "cloudwatch:DescribeAlarms",
                "cloudwatch:TagResource",
                "cloudwatch:UntagResource",
                "cloudwatch:ListTagsForResource"
              ],
              "Resource": [
                "arn:aws:cloudwatch:us-east-1:650387442642:alarm:portfolio-api-cloud-test-*"
              ]
            },
            {
              "Sid": "CreateBoundedRuntime",
              "Effect": "Allow",
              "Action": [
                "iam:CreateRole",
                "iam:PutRolePermissionsBoundary",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy"
              ],
              "Resource": ["arn:aws:iam::650387442642:role/PortfolioApiCloudTestRuntime*"],
              "Condition": {
                "StringEquals": {
                  "iam:PermissionsBoundary": "arn:aws:iam::650387442642:policy/PortfolioApiCloudTestRuntimeBoundary"
                }
              }
            },
            {
              "Sid": "ManageRuntimeRole",
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:DeleteRole",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:ListAttachedRolePolicies"
              ],
              "Resource": ["arn:aws:iam::650387442642:role/PortfolioApiCloudTestRuntime*"]
            },
            {
              "Sid": "PassBoundedRuntime",
              "Effect": "Allow",
              "Action": ["iam:PassRole"],
              "Resource": ["arn:aws:iam::650387442642:role/PortfolioApiCloudTestRuntime*"],
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "lambda.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadBootstrapVersion",
              "Effect": "Allow",
              "Action": ["ssm:GetParameters"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/cdk-bootstrap/papiatest/version"
              ]
            },
            {
              "Sid": "ReadAssets",
              "Effect": "Allow",
              "Action": ["s3:GetObject"],
              "Resource": ["arn:aws:s3:::cdk-papiatest-assets-650387442642-us-east-1/*"]
            },
            {
              "Fn::If": [
                "RegionalApiBootstrap",
                {
                  "Sid": "CreateNamedApi",
                  "Effect": "Allow",
                  "Action": ["apigateway:POST"],
                  "Resource": ["arn:aws:apigateway:us-east-1::/apis"],
                  "Condition": {
                    "StringEquals": {
                      "apigateway:Request/ApiName": "portfolio-api-cloud-test"
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Fn::If": [
                "ApiManagementEnabled",
                {
                  "Sid": "ManageApiResources",
                  "Effect": "Allow",
                  "Action": [
                    "apigateway:GET",
                    "apigateway:POST",
                    "apigateway:PATCH",
                    "apigateway:PUT",
                    "apigateway:DELETE",
                    "apigateway:TagResource"
                  ],
                  "Resource": {
                    "Fn::If": [
                      "HasApiId",
                      [
                        {
                          "Fn::Sub": "arn:aws:apigateway:us-east-1::/apis/${TestApiId}"
                        },
                        {
                          "Fn::Sub": "arn:aws:apigateway:us-east-1::/apis/${TestApiId}/*"
                        }
                      ],
                      ["arn:aws:apigateway:us-east-1::/apis/*"]
                    ]
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            {
              "Sid": "ManageCustomDomain",
              "Effect": "Allow",
              "Action": [
                "apigateway:GET",
                "apigateway:POST",
                "apigateway:PATCH",
                "apigateway:DELETE"
              ],
              "Resource": [
                "arn:aws:apigateway:us-east-1::/domainnames/api.matiasgaleano.dev",
                "arn:aws:apigateway:us-east-1::/domainnames/api.matiasgaleano.dev/*"
              ]
            },
            {
              "Sid": "ReadDomainCertificate",
              "Effect": "Allow",
              "Action": ["acm:DescribeCertificate"],
              "Resource": [
                "arn:aws:acm:us-east-1:650387442642:certificate/a5cb7eb1-ad11-404f-981b-e3d05c8c5de7"
              ]
            },
            {
              "Sid": "CreateRegionalProjectDomain",
              "Effect": "Allow",
              "Action": ["apigateway:POST"],
              "Resource": ["arn:aws:apigateway:us-east-1::/domainnames"],
              "Condition": {
                "StringEquals": {
                  "aws:RequestTag/Project": "portfolio-api-cloud"
                },
                "ForAllValues:StringEquals": {
                  "apigateway:Request/EndpointType": "REGIONAL"
                },
                "Null": {
                  "apigateway:Request/EndpointType": "false"
                }
              }
            },
            {
              "Sid": "ManageExactCustomDomainTags",
              "Effect": "Allow",
              "Action": ["apigateway:GET", "apigateway:PUT", "apigateway:DELETE"],
              "Resource": [
                "arn:aws:apigateway:us-east-1::/tags/arn%3Aaws%3Aapigateway%3Aus-east-1%3A%3A%2Fdomainnames%2Fapi.matiasgaleano.dev"
              ]
            }
          ]
        }
      }
    },
    "RuntimeBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "PortfolioApiCloudTestRuntimeBoundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "WriteOwnLogs",
              "Effect": "Allow",
              "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
              "Resource": [
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test:log-stream:*",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test-chat:log-stream:*",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test-process-release:log-stream:*",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test-generate-og:log-stream:*",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test-notify-post:log-stream:*",
                "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/portfolio-api-cloud-test-publish-chat-knowledge:log-stream:*"
              ]
            },
            {
              "Sid": "ControlOnly",
              "Effect": "Allow",
              "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
              "Resource": [
                "arn:aws:dynamodb:us-east-1:650387442642:table/portfolio-api-cloud-test-control"
              ]
            },
            {
              "Sid": "ReadRuntimeParameters",
              "Effect": "Allow",
              "Action": ["ssm:GetParameter"],
              "Resource": [
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/api",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/chat",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/editorial",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/notifications",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/validation/api",
                "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/validation/chat"
              ]
            },
            {
              "Sid": "DecryptRuntimeParameters",
              "Effect": "Allow",
              "Action": ["kms:Decrypt"],
              "Resource": ["arn:aws:kms:us-east-1:650387442642:key/*"],
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "ssm.us-east-1.amazonaws.com",
                  "kms:EncryptionContext:PARAMETER_ARN": [
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/api",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/chat",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/editorial",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/notifications",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/validation/api",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/validation/chat"
                  ]
                }
              }
            },
            {
              "Sid": "InvokeEditorialStages",
              "Effect": "Allow",
              "Action": ["lambda:InvokeFunction"],
              "Resource": [
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-generate-og",
                "arn:aws:lambda:us-east-1:650387442642:function:portfolio-api-cloud-test-notify-post"
              ]
            },
            {
              "Fn::If": [
                "HasPreviousRuntimeSecret",
                {
                  "Sid": "ReadPreviousSecretDuringCutover",
                  "Effect": "Allow",
                  "Action": ["secretsmanager:GetSecretValue"],
                  "Resource": [
                    {
                      "Ref": "PreviousRuntimeSecretArn"
                    }
                  ]
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "GitHubDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "PortfolioApiCloudTestGitHubDeployRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": "arn:aws:iam::650387442642:oidc-provider/token.actions.githubusercontent.com"
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:matigaleanodev@99203645/portfolio-api-cloud@1432631186:environment:production-plan"
                }
              }
            }
          ]
        },
        "PermissionsBoundary": {
          "Ref": "GitHubBoundary"
        },
        "Policies": [
          {
            "PolicyName": "TestDeliveryOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "AssumeDeliveryRoles",
                  "Effect": "Allow",
                  "Action": ["sts:AssumeRole"],
                  "Resource": [
                    "arn:aws:iam::650387442642:role/PortfolioApiCloudTestCdkDeployRole",
                    "arn:aws:iam::650387442642:role/PortfolioApiCloudTestFilePublishingRole"
                  ]
                },
                {
                  "Sid": "VerifyRuntimeParameters",
                  "Effect": "Allow",
                  "Action": ["ssm:GetParameters"],
                  "Resource": [
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/api",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/chat",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/editorial",
                    "arn:aws:ssm:us-east-1:650387442642:parameter/portfolio/prod/notifications"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "CdkDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "PortfolioApiCloudTestCdkDeployRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::650387442642:role/PortfolioApiCloudTestGitHubDeployRole"
              },
              "Action": "sts:AssumeRole"
